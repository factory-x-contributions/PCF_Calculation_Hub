# Core application settings
APP_NAME=PCF Creator API
ENVIRONMENT=local
DEBUG=false

# Basic auth for /data_base_view
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# Session cookie signing (use a long random string in production)
SESSION_SECRET_KEY=change-me-in-production
# Omit or set true/false; when unset, Secure flag is on when ENVIRONMENT is not "local"
# SESSION_COOKIE_SECURE=true
# Only set true when a trusted reverse proxy sets X-Forwarded-For (spoofable if exposed)
# TRUST_FORWARDED_HEADERS=false

# --- Microsoft Entra ID (Azure AD) web sign-in ---
# Register a "Web" application; redirect URI = {PUBLIC_BASE_URL}/api/auth/microsoft/callback
# (with stage prefix before /api when ENVIRONMENT is not local, e.g. https://host/dev/api/...).
# MICROSOFT_ENTRA_TENANT_ID=
# MICROSOFT_ENTRA_CLIENT_ID=
# MICROSOFT_ENTRA_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://localhost:8443
# ALLOWED_USERS_PATH=app/data/allowed_users.json
# ALLOWED_USERS_S3_BUCKET=
# ALLOWED_USERS_S3_KEY=
# Comma-separated emails always allowed as admins until removed from env (bootstrap)
# ENTRA_BOOTSTRAP_ADMIN_EMAILS=
# ENABLE_LEGACY_PASSWORD_LOGIN=true

# Path to the JSON database (relative to project root)
DATABASE_PATH=app/data/data_base.json
# Optional durable storage for database (for AWS/S3 deployments)
DATABASE_S3_BUCKET=
DATABASE_S3_KEY=

# Single listen port (8443): TLS when SSL_CERTFILE + SSL_KEYFILE exist and resolve; else plain HTTP on this port.
# PORT_HTTPS=8443

# Server: `python -m app.main` and Gunicorn bind only PORT_HTTPS (default 8443).
PORT_HTTPS=8443
# SSL certs for TLS on PORT_HTTPS (optional: if missing, app serves plain HTTP on 8443)
SSL_CERTFILE=cert.pem
SSL_KEYFILE=key.pem

